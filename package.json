    "jest": "^30.4.2",
    "prettier": "^2.0.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslint": "^5.19.0",
    "tslint-config-airbnb": "^5.11.1",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.3.3"
